#!/bin/sh
set -u

TAG="$(uci -q get dns-failover.main.log_tag || echo dns-failover)"
API="$(uci -q get dns-failover.main.api || echo http://127.0.0.1:9090)"
SELECTOR="$(uci -q get dns-failover.main.selector || echo DNS-Transport)"
PREFERRED="$(uci -q get dns-failover.main.preferred || echo WARP)"
SECONDARY="$(uci -q get dns-failover.main.secondary || echo My-VPS)"
PROBE="$(uci -q get dns-failover.main.dns_probe || echo openwrt.org)"

log() { logger -t "$TAG" "$*"; }

proxy_delay() {
    curl --noproxy '*' -fsS --max-time 7 -G "$API/proxies/$1/delay" \
      --data-urlencode 'url=https://www.gstatic.com/generate_204' \
      --data-urlencode 'timeout=5000' 2>/dev/null |
      jsonfilter -e '@.delay' 2>/dev/null
}

dns_test() {
    local body status
    body="$(curl --noproxy '*' -fsS --max-time 8 \
      "$API/dns/query?name=$PROBE&type=A" 2>/dev/null)" || return 1
    status="$(printf '%s' "$body" | jsonfilter -e '@.Status' 2>/dev/null)"
    case "$status" in
        0|3) return 0 ;;
        *) return 1 ;;
    esac
}

select_proxy() {
    case "$1" in
        "$PREFERRED"|"$SECONDARY") ;;
        *) echo "Allowed values: $PREFERRED or $SECONDARY" >&2; return 2 ;;
    esac
    curl --noproxy '*' -fsS --max-time 8 -X PUT \
      "$API/proxies/$SELECTOR" -H 'Content-Type: application/json' \
      -d "{\"name\":\"$1\"}" >/dev/null
    echo "Selected $1 in $SELECTOR"
    log "manual selector change: $SELECTOR=$1"
}

run_once() {
    [ "$(uci -q get dns-failover.main.enabled)" = "1" ] || return 0
    a="$(proxy_delay "$PREFERRED")"
    b="$(proxy_delay "$SECONDARY")"
    [ -n "$a" ] && [ "$a" -gt 0 ] 2>/dev/null && pa="OK ${a}ms" || pa="FAIL"
    [ -n "$b" ] && [ "$b" -gt 0 ] 2>/dev/null && pb="OK ${b}ms" || pb="FAIL"
    dns_test && dt="OK" || dt="FAIL"
    log "mode=monitor preferred=$PREFERRED($pa) secondary=$SECONDARY($pb) mihomo_dns=$dt; no automatic changes"
}

case "${1:-}" in
    once) run_once ;;
    select) [ "$#" -eq 2 ] || exit 2; select_proxy "$2" ;;
    status)
        echo "DNS Failover: monitor + manual"
        echo "enabled=$(uci -q get dns-failover.main.enabled)"
        echo "mode=$(uci -q get dns-failover.main.mode)"
        echo "selector=$SELECTOR"
        echo "preferred=$PREFERRED"
        echo "secondary=$SECONDARY"
        echo "dns_probe=$PROBE"
        ;;
    *) echo "Usage: $0 {once|status|select WARP|select My-VPS}" >&2; exit 2 ;;
esac
