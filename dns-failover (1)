#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    [ "$(uci -q get dns-failover.main.enabled)" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /bin/sh -c 'while :; do /usr/sbin/dns-failover once; sleep "$(uci -q get dns-failover.main.interval || echo 60)"; done'
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
